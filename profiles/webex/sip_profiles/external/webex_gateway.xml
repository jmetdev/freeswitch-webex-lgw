<include>
  <!--
    Webex Calling registration-based trunk (Local Gateway).
    Fill in the webex_* values in vars.xml; this file should not need edits.

    Registration model per Cisco CUBE LGW spec (Webex registration trunk):
      - REGISTER identity uses registrar domain in From/To (16855334…bcld.webex.com)
      - TLS connection via outbound-proxy SRV (_sips._tcp.da07… → port 8934)
      - Registration trunks do not use a Control Hub FQDN. The site is identified by
        ;otg= on the From URI (CUBE sip-profile rule 80). Contact stays the public IP.
      - AOR / Contact user = Line/Port; digest auth uses separate trunk username
      - realm BroadWorks, 240s expiry, SRTP mandatory
  -->
  <gateway name="webex">
    <param name="username" value="$${webex_line_port}"/>
    <param name="auth-username" value="$${webex_username}"/>
    <param name="password" value="$${webex_password}"/>
    <param name="realm" value="BroadWorks"/>
    <param name="from-user" value="$${webex_line_port}"/>
    <param name="from-domain" value="$${webex_registrar};otg=$${webex_otg}"/>
    <!-- CUBE: outbound-proxy dns:da07… — Sofia resolves SRV/NAPTR to access SBC (port 8934) -->
    <param name="proxy" value="$${webex_outbound_proxy}"/>
    <param name="register-proxy" value="$${webex_outbound_proxy}"/>
    <param name="outbound-proxy" value="$${webex_outbound_proxy}"/>
    <param name="register" value="true"/>
    <param name="register-transport" value="tls"/>
    <param name="expire-seconds" value="240"/>
    <param name="retry-seconds" value="30"/>
    <!-- CUBE/Webex: OPTIONS keepalive required for Control Hub trunk Online status -->
    <param name="ping" value="30"/>
    <param name="extension" value="$${webex_line_port}"/>
    <!-- Enable AFTER Control Hub provisions webex_contact_fqdn for this trunk:
         ./scripts/enable-webex-contact-fqdn.sh (otherwise REGISTER → FAIL_WAIT) -->
    <!-- <param name="extension-in-contact" value="true"/> -->
    <!-- <param name="contact-host" value="$${webex_contact_fqdn}"/> -->
    <param name="context" value="public"/>
    <param name="caller-id-in-from" value="true"/>
    <variables>
      <variable name="rtp_secure_media" value="mandatory:AES_CM_128_HMAC_SHA1_80" direction="outbound"/>
      <variable name="rtp_secure_media" value="mandatory:AES_CM_128_HMAC_SHA1_80" direction="inbound"/>
    </variables>
  </gateway>
</include>
