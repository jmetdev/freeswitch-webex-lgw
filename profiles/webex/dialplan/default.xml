<include>
  <context name="default">
    <extension name="health_check">
      <condition field="destination_number" expression="^9191$">
        <action application="answer"/>
        <action application="playback" data="tone_stream://%(2000,4000,440,480)"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!--
      Alert Office conference. Room name is the dialed number so ESL json_list
      and recordings (2111-YYYYMMDD-HHMMSS.wav) stay numeric.
    -->
    <extension name="alert_office_2111">
      <condition field="destination_number" expression="^2111$">
        <action application="set" data="callee_id_name=Alert Office"/>
        <action application="set" data="callee_id_number=2111"/>
        <action application="set" data="effective_callee_id_name=Alert Office"/>
        <action application="set" data="effective_callee_id_number=2111"/>
        <action application="export" data="sip_h_P-Asserted-Identity=&quot;Alert Office&quot; &lt;sip:2111@$${external_sip_ip}&gt;"/>
        <action application="answer"/>
        <action application="send_display" data="Alert Office|2111"/>
        <action application="conference" data="2111@default"/>
      </condition>
    </extension>

    <!--
      Outbound to Webex Calling. The From URI must carry the same ;otg= tag the
      gateway puts on REGISTER and OPTIONS (from-domain in webex_gateway.xml).
      That tag, not a DNS name, is how Webex associates the call with the trunk.
    -->
    <extension name="webex_outbound">
      <condition field="destination_number" expression="^(\+?\d{7,15})$">
        <action application="export" data="nolocal:sip_invite_full_from=&lt;sip:${caller_id_number}@$${webex_registrar};otg=$${webex_otg}&gt;"/>
        <action application="bridge" data="sofia/gateway/webex/$1"/>
      </condition>
    </extension>

  <!--
    Outbound trunk example with stereo WAV recording:

    <extension name="outbound_recorded">
      <condition field="destination_number" expression="^(\d+)$">
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="record_session" data="$${recordings_dir}/${uuid}.wav"/>
        <action application="bridge" data="sofia/gateway/my_trunk/$1"/>
      </condition>
    </extension>
  -->

    <!-- Inbound fax (T.38) — matches Webex Line/Port from vars.xml -->
    <extension name="inbound_fax">
      <condition field="destination_number" expression="^$${webex_line_port}$">
        <action application="set" data="fax_enable_t38=true"/>
        <action application="set" data="fax_enable_t38_request=true"/>
        <action application="set" data="echo_cancel_type=none"/>
        <action application="answer"/>
        <action application="playback" data="silence_stream://2000"/>
        <action application="rxfax" data="/var/spool/fax/${uuid}.tif"/>
        <action application="hangup"/>
      </condition>
    </extension>
  </context>

  <context name="public">
    <extension name="unloop">
      <condition field="${unroll_loops}" expression="^true$"/>
      <condition field="${sip_looped_call}" expression="^true$">
        <action application="deflect" data="${destination_number}"/>
      </condition>
    </extension>

    <!--
      Inbound from Webex Calling. The gateway's "extension" param rewrites
      destination_number to the Line/Port. The dialed number is ${sip_to_user}
      / ${sip_req_user} (bare field names like sip_to_user do not work here).
      Transfer that number into default so 2111 hits the conference instead of
      inbound_fax.
    -->
    <extension name="alert_office_2111_inbound">
      <condition field="destination_number" expression="^2111$">
        <action application="transfer" data="2111 XML default"/>
      </condition>
    </extension>
    <extension name="alert_office_2111_to_user">
      <condition field="${sip_to_user}" expression="^2111$">
        <action application="set" data="callee_id_name=Alert Office"/>
        <action application="set" data="callee_id_number=2111"/>
        <action application="set" data="effective_callee_id_name=Alert Office"/>
        <action application="set" data="effective_callee_id_number=2111"/>
        <action application="export" data="sip_h_P-Asserted-Identity=&quot;Alert Office&quot; &lt;sip:2111@$${external_sip_ip}&gt;"/>
        <action application="answer"/>
        <action application="send_display" data="Alert Office|2111"/>
        <action application="conference" data="2111@default"/>
      </condition>
    </extension>
    <extension name="alert_office_2111_req_user">
      <condition field="${sip_req_user}" expression="^2111$">
        <action application="set" data="callee_id_name=Alert Office"/>
        <action application="set" data="callee_id_number=2111"/>
        <action application="set" data="effective_callee_id_name=Alert Office"/>
        <action application="set" data="effective_callee_id_number=2111"/>
        <action application="export" data="sip_h_P-Asserted-Identity=&quot;Alert Office&quot; &lt;sip:2111@$${external_sip_ip}&gt;"/>
        <action application="answer"/>
        <action application="send_display" data="Alert Office|2111"/>
        <action application="conference" data="2111@default"/>
      </condition>
    </extension>
    <extension name="webex_inbound">
      <condition field="destination_number" expression="^$${webex_line_port}$">
        <action application="transfer" data="${sip_to_user} XML default"/>
      </condition>
    </extension>
  </context>
</include>
