<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- mod_event_socket ANDs every apply-inbound-acl entry and defaults to loopback.auto.
         A second param would not widen access. This one list allows fs_cli on loopback
         and other containers on RFC1918 addresses (Docker bridges included). -->
    <list name="esl" default="deny">
      <node type="allow" cidr="127.0.0.0/8"/>
      <node type="allow" cidr="::1/128"/>
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>
  </network-lists>
</configuration>
