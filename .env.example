# Profile overlay applied at container start (default: webex)
FS_PROFILE=webex

# Published image tag (compose pulls/builds when IMAGE/TAG set)
IMAGE=ghcr.io/jmetdev/freeswitch-webex-lgw
TAG=latest

# Event Socket Layer. The entrypoint writes these into event_socket.conf.xml.
# 127.0.0.1 is the host loopback only; a container on a bridge network cannot reach it.
# Set ESL_LISTEN_IP to this host's LAN address (or 0.0.0.0) and point the other app there.
# apply-inbound-acl defaults to loopback.auto, which answers other containers with
# text/rude-rejection. ESL_ACL selects the list in acl.conf.xml (loopback + RFC1918).
# Do not publish 8021 on the public firewall.
ESL_PASSWORD=ChangeMe-ESL-Password
# ESL_LISTEN_IP=127.0.0.1
# ESL_ACL=esl

# Public IPv4 advertised in SIP/RTP (required on VPS behind NAT)
EXTERNAL_SIP_IP=0.0.0.0
EXTERNAL_RTP_IP=0.0.0.0

# Webex Calling registration trunk (Control Hub → Trunks → Registration based)
WEBEX_REGISTRAR=
WEBEX_OUTBOUND_PROXY=da07.sipconnect-us.bcld.webex.com
# Line/Port user part only, before @. Including the registrar domain doubles the From URI.
WEBEX_LINE_PORT=
WEBEX_USERNAME=
WEBEX_PASSWORD=
# Trunk group tag. The gateway puts this on the From URI as ;otg=.
# Without it, Sofia shows REGED and Control Hub stays Unknown. Not a DNS name.
WEBEX_OTG=
# Leave empty. contact-host / a public FQDN is the certificate-based trunk model.
WEBEX_CONTACT_FQDN=
